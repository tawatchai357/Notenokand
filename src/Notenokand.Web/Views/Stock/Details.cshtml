@model Notenokand.Web.Models.Stock.SaleDetailsViewModel
@using Notenokand.Domain.Enums
@{ ViewData["Title"] = "รายละเอียดการขาย"; var sale = Model.Sale; }
@section Head { <link rel="stylesheet" href="~/css/stock.css" asp-append-version="true" /> }
<section class="stock-page">
<a class="btn btn-soft mb-3" asp-action="Sales">‹ ประวัติขาย</a><h1>รายละเอียดการขาย</h1>
@if (TempData["StockError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="content-card mb-3"><small>@sale.DocumentNumber</small><h2>@sale.Buyer.Name</h2><p>@sale.SaleDate.ToString("d MMM yyyy", new System.Globalization.CultureInfo("th-TH")) · @sale.SaleLocation</p><p>วิธีชำระ: @(sale.PaymentMethod == "Cash" ? "เงินสด" : sale.PaymentMethod == "BankTransfer" ? "โอนเงิน" : sale.PaymentMethod == "CreditCard" ? "บัตรเครดิต" : "อื่น ๆ")</p>
<strong class="@(sale.Status == SaleStatus.Cancelled ? "text-danger" : "text-success")">@(sale.Status == SaleStatus.Cancelled ? "ยกเลิกแล้ว — คืนสต็อกและนำรายรับออกจากยอดสรุปแล้ว" : "รับเงินครบแล้ว — ตัดสต็อกและเชื่อมรายรับแล้ว")</strong>
@if (!string.IsNullOrWhiteSpace(sale.Notes)) { <p class="stock-note">@sale.Notes</p> }</div>
<div class="stock-metrics mb-3"><div><small>น้ำหนักรวม</small><strong>@Model.TotalKg.ToString("N3") กก.</strong></div><div><small>ยอดขาย</small><strong>@sale.NetAmount.ToString("N2") บาท</strong></div><div><small>ราคาเฉลี่ย / กก.</small><strong>@Model.AveragePrice.ToString("N2") บาท</strong></div></div>
@foreach (var line in sale.Items) {
<article class="content-card mb-3"><a asp-controller="Buildings" asp-action="Details" asp-route-id="@line.HarvestItem.HarvestRound.BuildingId">@line.HarvestItem.HarvestRound.Building.Name</a><h2>@Model.Stock.Name(line.HarvestItem.NestTypeId)</h2><p>@Model.Stock.Name(line.HarvestItem.ColorId) · @Model.Stock.Name(line.HarvestItem.ConditionId)</p><small>ล็อต @line.HarvestItem.HarvestRound.RoundNumber</small><p>@line.WeightKg.ToString("N3") กก. × @line.PricePerKg.ToString("N2") บาท</p><strong>@line.NetAmount.ToString("N2") บาท</strong></article>
}
@if (sale.Status == SaleStatus.Confirmed) {
<div class="content-card"><p>หากข้อมูลผิด ให้ยกเลิกแล้วบันทึกใหม่ ห้ามแก้หรือลบรายรับที่เชื่อมจากหน้าการเงินโดยตรง</p><p class="text-danger">การยกเลิกเป็นการย้อนรายการที่บันทึกผิด ไม่ใช่การบันทึกคืนสินค้าจริงหรือคืนเงินบางส่วน</p><form asp-action="Cancel" asp-route-id="@sale.Id" method="post" data-cancel-sale><button class="btn btn-outline-danger" type="submit">ยกเลิกการขายและคืนสต็อก</button></form></div>
}
</section>
@section Scripts { <script src="~/js/lot-sale.js" asp-append-version="true"></script> }
