@model Notenokand.Web.Models.Account.ProfileModel
@{ ViewData["Title"] = "บัญชีของฉัน"; }
<section class="content-card my-4 mx-auto" style="max-width:640px"><h1>บัญชีของฉัน</h1><p>@Model.Email</p>
<form method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="DisplayName">ชื่อและนามสกุล</label><input asp-for="DisplayName" class="form-control mb-3" autocomplete="name" /><label asp-for="PhoneNumber">โทรศัพท์</label><input asp-for="PhoneNumber" class="form-control mb-3" autocomplete="tel" /><button class="btn btn-primary">บันทึก</button><a class="btn btn-soft" asp-action="ChangePassword">เปลี่ยนรหัสผ่าน</a></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
