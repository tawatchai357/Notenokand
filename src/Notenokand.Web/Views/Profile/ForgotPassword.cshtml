@model Notenokand.Web.Models.Account.ForgotPasswordModel
@{ ViewData["Title"] = "ลืมรหัสผ่าน"; }
<section class="content-card my-4 mx-auto" style="max-width:640px"><h1>ลืมรหัสผ่าน</h1><p>รับลิงก์ตั้งรหัสผ่านใหม่ทางอีเมลที่ยืนยันแล้ว</p>
@if (!(bool)(ViewBag.EmailReady ?? false)) { <div class="alert alert-warning">ผู้ดูแลยังไม่ได้ตั้งค่าบริการส่งอีเมล</div> }
<form method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Email">อีเมล</label><input asp-for="Email" class="form-control mb-3" autocomplete="email" /><button class="btn btn-primary">ขอลิงก์ตั้งรหัสผ่านใหม่</button></form><a asp-controller="Account" asp-action="Login">กลับเข้าสู่ระบบ</a></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
