@model Notenokand.Web.Models.Account.ChangePasswordModel
@{ ViewData["Title"] = "เปลี่ยนรหัสผ่าน"; }
<section class="content-card my-4 mx-auto" style="max-width:640px"><h1>เปลี่ยนรหัสผ่าน</h1><p>อย่างน้อย 10 ตัว มี A–Z, a–z, ตัวเลขและอักขระพิเศษ</p><form method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="CurrentPassword">รหัสผ่านปัจจุบัน</label><input asp-for="CurrentPassword" class="form-control mb-3" autocomplete="current-password" /><label asp-for="Password">รหัสผ่านใหม่</label><input asp-for="Password" class="form-control mb-3" autocomplete="new-password" /><label asp-for="ConfirmPassword">ยืนยันรหัสผ่านใหม่</label><input asp-for="ConfirmPassword" class="form-control mb-3" autocomplete="new-password" /><button class="btn btn-primary">เปลี่ยนรหัสผ่าน</button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
