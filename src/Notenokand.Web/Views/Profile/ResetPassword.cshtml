@model Notenokand.Web.Models.Account.ResetPasswordModel
@{ ViewData["Title"] = "ตั้งรหัสผ่านใหม่"; }
<section class="content-card my-4 mx-auto" style="max-width:640px"><h1>ตั้งรหัสผ่านใหม่</h1><p>อย่างน้อย 10 ตัว มี A–Z, a–z, ตัวเลขและอักขระพิเศษ</p><form method="post"><input asp-for="Code" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Email">อีเมล</label><input asp-for="Email" class="form-control mb-3" autocomplete="email" /><label asp-for="Password">รหัสผ่านใหม่</label><input asp-for="Password" class="form-control mb-3" autocomplete="new-password" /><label asp-for="ConfirmPassword">ยืนยันรหัสผ่าน</label><input asp-for="ConfirmPassword" class="form-control mb-3" autocomplete="new-password" /><button class="btn btn-primary">ตั้งรหัสผ่านใหม่</button></form><a asp-action="ForgotPassword">ขอลิงก์ใหม่</a></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
