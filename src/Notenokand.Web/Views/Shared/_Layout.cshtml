@using System.Text.Json
@{
  var bodyClass = ViewData["BodyClass"]?.ToString() ?? string.Empty;
  var showChrome = !bodyClass.Contains("auth-page") && !bodyClass.Contains("onboarding-page");
  var showAppNav = showChrome && User.Identity?.IsAuthenticated == true;
  var renderedBodyClass = string.Join(" ", new[] { bodyClass, showAppNav ? "has-app-footer" : string.Empty }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#1565d8" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Notenokand" />
  <link rel="manifest" href="~/manifest.webmanifest" />
  <link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon.png" />
  <title>@ViewData["Title"] - Notenokand</title>
  <meta name="description" content="ระบบจัดการค่าใช้จ่าย ผลผลิต สต็อก และยอดขายสำหรับกิจการบ้านนกแอ่น" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/appointment-notifications.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/pwa.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/Notenokand.Web.styles.css" asp-append-version="true" />
  @await RenderSectionAsync("Head", required: false)
</head>
<body class="@renderedBodyClass">
<partial name="_PwaStatus" />
@if (showChrome)
{
  <header class="site-header"><nav class="container nav-shell"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">N</span><span>NOTENOKAND</span></a><div class="nav-links d-none d-md-flex"><a href="/#features">ความสามารถ</a><a href="#">เกี่ยวกับเรา</a></div><div class="nav-actions">@if (User.Identity?.IsAuthenticated == true) { @await Component.InvokeAsync("AppointmentAlerts") <a class="btn btn-soft d-none d-sm-inline-flex" asp-controller="Dashboard" asp-action="Index">ภาพรวม</a><a class="btn btn-soft d-none d-md-inline-flex" asp-controller="Finance" asp-action="Index">รายรับ–ค่าใช้จ่าย</a><a class="btn btn-soft d-none d-lg-inline-flex" asp-controller="Calendar" asp-action="Index">ปฏิทิน</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-link" type="submit">ออกจากระบบ</button></form> } else { <a class="login-link" asp-controller="Account" asp-action="Login">เข้าสู่ระบบ</a><a class="btn btn-primary" asp-controller="Account" asp-action="Register">เริ่มใช้งาน</a> }</div></nav></header>
}
<main role="main" class="@(string.IsNullOrWhiteSpace(bodyClass) ? "container app-main" : "")">@RenderBody()</main>
@if (showAppNav) { <partial name="_AppBottomNav" /> }
@if (string.IsNullOrWhiteSpace(bodyClass))
{
  <footer class="site-footer"><div class="container"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">N</span><span>NOTENOKAND</span></a><div>@if(User.Identity?.IsAuthenticated == true){<a asp-controller="Dashboard" asp-action="Index">ภาพรวม</a><a asp-controller="Finance" asp-action="Index">การเงิน</a><a asp-controller="Calendar" asp-action="Index">ปฏิทิน</a><a asp-controller="Finance" asp-action="Categories">หมวดหมู่</a>}<a asp-controller="Home" asp-action="Terms">ข้อกำหนด</a><a asp-controller="Home" asp-action="Privacy">ความเป็นส่วนตัว</a><span>© 2026 Notenokand</span></div></div></footer>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/thai-datetime-picker.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/pwa.js" asp-append-version="true" data-sw-url="@Url.Content("~/sw.js")"></script>
@if (TempData["SuccessMessage"] is string successMessage) { <script>window.notenokandAlert = @Html.Raw(JsonSerializer.Serialize(successMessage));</script> }
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
