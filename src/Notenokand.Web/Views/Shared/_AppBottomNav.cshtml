@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var dashboardActive = controller == "Dashboard";
    var financeActive = controller == "Finance" && action != "Categories" && action != "CreateCategory" && action != "ToggleCategory";
    var buildingsActive = controller == "Buildings";
    var calendarActive = controller == "Calendar";
}
<nav class="app-bottom-nav" aria-label="เมนูหลักด้านล่าง">
    <a class="bottom-nav-item @(dashboardActive ? "active" : "")" asp-controller="Dashboard" asp-action="Index" aria-current="@(dashboardActive ? "page" : null)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.8 12 3l9 7.8v9.7a.5.5 0 0 1-.5.5H15v-7H9v7H3.5a.5.5 0 0 1-.5-.5z"/></svg><span>ภาพรวม</span>
    </a>
    <a class="bottom-nav-item @(financeActive ? "active" : "")" asp-controller="Finance" asp-action="Index" aria-current="@(financeActive ? "page" : null)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h3M14 13h2M8 16h3M14 16h2"/></svg><span>การเงิน</span>
    </a>
    <button class="bottom-nav-add" type="button" data-bs-toggle="offcanvas" data-bs-target="#quickAddSheet" aria-controls="quickAddSheet" aria-label="เพิ่มข้อมูล"><span>+</span><small>เพิ่ม</small></button>
    <a class="bottom-nav-item @(buildingsActive ? "active" : "")" asp-controller="Dashboard" asp-action="Index" asp-fragment="buildings" aria-current="@(buildingsActive ? "page" : null)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V7l7-4 7 4v14M9 9h2M14 9h2M9 13h2M14 13h2M9 17h2M14 17h2"/></svg><span>ตึกนก</span>
    </a>
    <a class="bottom-nav-item @(calendarActive ? "active" : "")" asp-controller="Calendar" asp-action="Index" aria-current="@(calendarActive ? "page" : null)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14a1 1 0 0 1 1 1v15H4V5a1 1 0 0 1 1-1ZM8 2v4M16 2v4M4 9h16M8 13h2M14 13h2M8 17h2M14 17h2"/></svg><span>ปฏิทิน</span>
    </a>
</nav>
<div class="offcanvas offcanvas-bottom quick-add-sheet" tabindex="-1" id="quickAddSheet" aria-labelledby="quickAddTitle">
    <div class="offcanvas-header"><div><small>คำสั่งด่วน</small><h2 class="offcanvas-title" id="quickAddTitle">ต้องการเพิ่มอะไร?</h2></div><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="ปิด"></button></div>
    <div class="offcanvas-body"><div class="quick-add-grid"><a asp-controller="Stock" asp-action="Index"><span class="building">▤</span><div><strong>สต็อกรังนก</strong><small>ดูยอดคงเหลือแยกล็อต</small></div></a><a asp-controller="Stock" asp-action="Create"><span class="income">↗</span><div><strong>ขายจากล็อต</strong><small>ตัดสต็อกและสร้างรายรับ</small></div></a><a asp-controller="Harvest" asp-action="Create"><span class="building">◈</span><div><strong>บันทึกเก็บรังนก</strong><small>แยกประเภท สี สภาพ และน้ำหนัก</small></div></a><a asp-controller="Harvest" asp-action="Index"><span class="building">▤</span><div><strong>ประวัติเก็บรังนก</strong><small>ดูรายการเก็บที่ผ่านมา</small></div></a><a asp-controller="Finance" asp-action="Create" asp-route-type="Expense"><span class="expense">↘</span><div><strong>เพิ่มค่าใช้จ่าย</strong><small>บันทึกค่าไฟ ค่าแรง หรือค่าใช้จ่ายอื่น</small></div></a><a asp-controller="Finance" asp-action="Create" asp-route-type="Income"><span class="income">↗</span><div><strong>เพิ่มรายรับ</strong><small>บันทึกยอดขายและรายได้ของกิจการ</small></div></a><a asp-controller="Buildings" asp-action="Create"><span class="building">⌂</span><div><strong>เพิ่มตึกนก</strong><small>เพิ่มข้อมูล รูปภาพ และตำแหน่งตึก</small></div></a><a asp-controller="Calendar" asp-action="Create"><span class="calendar">▦</span><div><strong>เพิ่มนัดหมาย</strong><small>วางแผนซ่อม เก็บรัง หรือขายรังนก</small></div></a></div><form class="quick-logout" asp-controller="Account" asp-action="Logout" method="post"><button type="submit">ออกจากระบบ</button></form></div>
</div>
