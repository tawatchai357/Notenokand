@model Notenokand.Web.Models.Account.DashboardViewModel
@{ ViewData["Title"] = "ภาพรวม"; }
<section class="dashboard-hero"><div><span class="eyebrow">@Model.AccountName</span><h1>สวัสดี @Model.DisplayName</h1><p>ภาพรวมกิจการวันนี้ ข้อมูลสำคัญแสดงเป็นการ์ดเพื่อดูง่ายในทุกหน้าจอ</p></div><button class="btn btn-primary">+ บันทึกข้อมูล</button></section><section class="metric-grid" aria-label="ตัวชี้วัดภาพรวม"><article class="metric-card"><span class="metric-icon">⌂</span><small>ตึกนก</small><strong>@Model.BuildingCount แห่ง</strong><a href="#">จัดการตึกนก →</a></article><article class="metric-card"><span class="metric-icon">◈</span><small>ค่าใช้จ่ายเดือนนี้</small><strong>฿0.00</strong><span class="muted">ยังไม่มีรายการ</span></article><article class="metric-card"><span class="metric-icon">↗</span><small>รายรับเดือนนี้</small><strong>฿0.00</strong><span class="muted">ยังไม่มีรายการ</span></article><article class="metric-card"><span class="metric-icon">◎</span><small>สต็อกคงเหลือ</small><strong>0 กก.</strong><span class="muted">ยังไม่มีรายการ</span></article></section><section class="content-card empty-state"><div class="empty-icon">＋</div><h2>เริ่มบันทึกข้อมูลแรก</h2><p>เพิ่มค่าใช้จ่าย ผลผลิต หรือข้อมูลตึกนก เพื่อให้ Dashboard เริ่มสรุปผล</p><div class="action-grid"><a href="#">บันทึกค่าใช้จ่าย</a><a href="#">เพิ่มตึกนก</a><a href="#">บันทึกผลผลิต</a></div></section>