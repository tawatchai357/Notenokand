@model Notenokand.Web.Models.Account.DashboardViewModel
@using Notenokand.Domain.Enums
@using System.Text.Json
@{
    ViewData["Title"] = "ภาพรวม";
    var activeCount = Model.Buildings.Count(x => x.Status == BuildingStatus.Active);
    var inactiveCount = Model.Buildings.Count - activeCount;
    string[] chartMonths = ["ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."];
}
<section class="dashboard-hero"><div><span class="eyebrow">@Model.AccountName</span><h1>สวัสดี @Model.DisplayName</h1><p>ดูภาพรวมและจัดการตึกนกทุกหลังจากหน้านี้</p></div><a class="btn btn-primary" asp-controller="Buildings" asp-action="Create">+ เพิ่มตึกนก</a></section>
<section class="metric-grid dashboard-metrics" aria-label="ตัวชี้วัดภาพรวม"><article class="metric-card"><span class="metric-icon">⌂</span><small>ตึกนกทั้งหมด</small><strong>@Model.BuildingCount แห่ง</strong><span class="muted">ใช้งาน @activeCount · ไม่ใช้งาน @inactiveCount</span></article><a class="metric-card metric-link" asp-controller="Finance" asp-action="Index" asp-route-type="@TransactionType.Expense"><span class="metric-icon">◈</span><small>ค่าใช้จ่ายเดือนนี้</small><strong>฿@Model.TotalExpenseThisMonth.ToString("N2")</strong><span class="muted">แตะเพื่อดูรายการ</span></a><a class="metric-card metric-link" asp-controller="Finance" asp-action="Index" asp-route-type="@TransactionType.Income"><span class="metric-icon">↗</span><small>รายรับเดือนนี้</small><strong>฿@Model.TotalIncomeThisMonth.ToString("N2")</strong><span class="muted">สุทธิ ฿@Model.NetThisMonth.ToString("N2")</span></a><article class="metric-card"><span class="metric-icon">◎</span><small>สต็อกคงเหลือ</small><strong>0 กก.</strong><span class="muted">ยังไม่มีรายการ</span></article></section>
<div class="my-3"><a class="btn btn-soft" asp-controller="Harvest" asp-action="Index">◈ การเก็บรังนก</a></div><section class="annual-finance-card content-card" aria-labelledby="annualFinanceTitle">
    <div class="annual-finance-heading">
        <div><span class="eyebrow">ภาพรวมการเงินรายปี</span><h2 id="annualFinanceTitle">เปรียบเทียบรายรับ–รายจ่าย</h2><p>ยอดรวมของทุกตึก แยกตามเดือน</p></div>
        <div class="annual-year-picker"><a asp-action="Index" asp-route-year="@(Model.FinanceYear - 1)" aria-label="ปีก่อน">‹</a><strong>พ.ศ. @(Model.FinanceYear + 543)</strong><a asp-action="Index" asp-route-year="@(Model.FinanceYear + 1)" aria-label="ปีถัดไป">›</a></div>
    </div>
    <div class="annual-chart-legend"><span class="income"><i></i>รายรับ</span><span class="expense"><i></i>รายจ่าย</span></div>
    <div class="annual-chart-scroll"><div class="annual-chart-canvas-wrap"><canvas data-annual-finance-chart data-labels="@JsonSerializer.Serialize(chartMonths)" data-income="@JsonSerializer.Serialize(Model.MonthlyIncome)" data-expense="@JsonSerializer.Serialize(Model.MonthlyExpense)" aria-label="กราฟเปรียบเทียบรายรับและรายจ่าย พ.ศ. @(Model.FinanceYear + 543)" role="img"></canvas></div></div>
    <div class="annual-finance-totals"><div class="income"><small>รายรับทั้งปี</small><strong>฿@Model.TotalIncomeThisYear.ToString("N2")</strong></div><div class="expense"><small>รายจ่ายทั้งปี</small><strong>฿@Model.TotalExpenseThisYear.ToString("N2")</strong></div><div class="@(Model.NetThisYear >= 0 ? "positive" : "negative")"><small>สุทธิทั้งปี</small><strong>฿@Model.NetThisYear.ToString("N2")</strong></div></div>
    <table class="visually-hidden"><caption>ยอดรายรับและรายจ่ายรายเดือน พ.ศ. @(Model.FinanceYear + 543)</caption><thead><tr><th>เดือน</th><th>รายรับ</th><th>รายจ่าย</th></tr></thead><tbody>@for(var index = 0; index < 12; index++){<tr><th>@chartMonths[index]</th><td>@Model.MonthlyIncome[index]</td><td>@Model.MonthlyExpense[index]</td></tr>}</tbody></table>
</section><section class="building-section" id="buildings"><div class="section-toolbar"><div><span class="eyebrow">สถานที่ดำเนินงาน</span><h2>รายการตึกนก</h2></div>@if(Model.Buildings.Count > 0){<div class="filter-pills" role="group" aria-label="กรองสถานะตึก"><button class="active" type="button" data-building-filter="all">ทั้งหมด <span>@Model.Buildings.Count</span></button><button type="button" data-building-filter="active">ใช้งาน <span>@activeCount</span></button><button type="button" data-building-filter="inactive">ไม่ใช้งาน <span>@inactiveCount</span></button></div>}</div>
@if(Model.Buildings.Count == 0){<div class="content-card empty-state"><div class="empty-icon">⌂</div><h2>เพิ่มตึกนกแห่งแรก</h2><p>บันทึกที่อยู่และปักหมุดบนแผนที่ เพื่อเชื่อมรายการค่าใช้จ่ายและผลผลิตในขั้นต่อไป</p><a class="btn btn-primary" asp-controller="Buildings" asp-action="Create">+ เพิ่มตึกนก</a></div>}else{<div class="building-grid">@foreach(var building in Model.Buildings){var statusKey=building.Status==BuildingStatus.Active?"active":"inactive";<article class="building-card" data-building-card data-status="@statusKey"><div class="building-photo-frame">@if(building.HasPhoto){<img src="@Url.Action("Photo", "Buildings", new { id = building.Id })" alt="รูปตึก @building.Name" loading="lazy" />}else{<span>⌂</span><small>ยังไม่มีรูปตึก</small>}</div><div class="building-card-top"><div class="building-identity"><span class="building-symbol">⌂</span><div><small>@building.Code</small><h3>@building.Name</h3></div></div><span class="status-badge @statusKey"><i></i>@(building.Status == BuildingStatus.Active ? "ใช้งาน" : "ไม่ใช้งาน")</span></div><div class="building-location"><span>⌖</span><p>@building.Location</p></div><div class="building-facts"><div><small>ขนาดตึก</small><strong>@(building.WidthMeters.HasValue && building.DepthMeters.HasValue ? $"{building.WidthMeters:0.##} × {building.DepthMeters:0.##} ม." : "—")</strong></div><div><small>สร้าง/ซื้อ · ชั้น/ห้อง</small><strong>@(building.BuiltOrPurchasedYearBuddhist.HasValue ? $"พ.ศ. {building.BuiltOrPurchasedYearBuddhist}" : "—") · @(building.FloorCount?.ToString() ?? "—")/@(building.RoomCount?.ToString() ?? "—")</strong></div><div><small>งบก่อสร้าง</small><strong>@(building.ConstructionBudget.HasValue ? $"฿{building.ConstructionBudget:N2}" : "—")</strong></div></div><div class="building-finance-totals" aria-label="ยอดการเงินสะสมของตึก"><div class="income"><small>รายรับรวม</small><strong>฿@building.TotalIncome.ToString("N2")</strong></div><div class="expense"><small>รายจ่ายรวม</small><strong>฿@building.TotalExpense.ToString("N2")</strong></div></div><div class="building-actions"><a class="btn btn-primary" asp-controller="Buildings" asp-action="Details" asp-route-id="@building.Id">ดูรายละเอียด</a>@if(building.Latitude.HasValue && building.Longitude.HasValue){<a class="btn btn-soft" href="https://www.openstreetmap.org/?mlat=@building.Latitude&amp;mlon=@building.Longitude#map=17/@building.Latitude/@building.Longitude" target="_blank" rel="noopener">ดูแผนที่</a>}else{<a class="btn btn-soft" asp-controller="Buildings" asp-action="Edit" asp-route-id="@building.Id">ปักหมุด</a>}<a class="btn btn-outline-primary" asp-controller="Buildings" asp-action="Edit" asp-route-id="@building.Id">แก้ไข</a><form asp-controller="Buildings" asp-action="ToggleStatus" asp-route-id="@building.Id" method="post" data-status-form data-name="@building.Name" data-next="@(building.Status == BuildingStatus.Active ? "inactive" : "active")"><button class="btn btn-link @(building.Status == BuildingStatus.Active ? "text-danger" : "text-success")" type="submit">@(building.Status == BuildingStatus.Active ? "ปิดใช้งาน" : "เปิดใช้งาน")</button></form></div></article>}</div><div class="no-filter-results" hidden>ไม่พบตึกในสถานะที่เลือก</div>}</section>
@section Scripts { <script src="~/js/building-dashboard.js" asp-append-version="true"></script><script src="~/js/dashboard-finance-chart.js" asp-append-version="true"></script> }
