@model Notenokand.Web.Models.Reports.ReportSummaryViewModel
@{ ViewData["Title"] = "รายงาน"; }
<section class="finance-page"><div class="editor-heading"><div><span class="eyebrow">รายงานกิจการ</span><h1>สรุปและส่งออกข้อมูล</h1></div><button class="btn btn-soft" type="button" onclick="window.print()">พิมพ์ / บันทึก PDF</button></div>
<form method="get" class="content-card row g-3 mb-3"><div class="col-sm-5"><label>ตั้งแต่วันที่</label><input name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-sm-5"><label>ถึงวันที่</label><input name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-sm-2 d-flex align-items-end"><button class="btn btn-primary w-100">แสดงผล</button></div></form>
<div class="metric-grid dashboard-metrics"><article class="metric-card"><small>รายรับ</small><strong>฿@Model.Income.ToString("N2")</strong></article><article class="metric-card"><small>รายจ่าย</small><strong>฿@Model.Expense.ToString("N2")</strong></article><article class="metric-card"><small>เก็บรัง</small><strong>@Model.HarvestKg.ToString("N3") กก.</strong></article><article class="metric-card"><small>สต็อกปัจจุบัน</small><strong>@Model.StockKg.ToString("N3") กก.</strong></article><article class="metric-card"><small>ยอดขายจากล็อต</small><strong>฿@Model.SalesAmount.ToString("N2")</strong><span>@Model.SalesKg.ToString("N3") กก.</span></article></div>
<div class="content-card mt-3"><h2>ส่งออกสำหรับ Excel</h2><p>ไฟล์ CSV เป็น UTF-8 เปิดด้วย Excel ได้ และคงค่าตัวเลขดิบเพื่อคำนวณต่อ</p><div class="d-flex flex-wrap gap-2"><a class="btn btn-soft" asp-action="FinanceCsv" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">การเงิน CSV</a><a class="btn btn-soft" asp-action="HarvestCsv" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">ผลผลิต/สต็อก CSV</a><a class="btn btn-soft" asp-action="SalesCsv" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">ยอดขาย CSV</a></div></div>
</section>
<style media="print">.site-header,.site-footer,.app-bottom-nav,.btn,form{display:none!important}.content-card{box-shadow:none}.app-main{max-width:none}</style>
