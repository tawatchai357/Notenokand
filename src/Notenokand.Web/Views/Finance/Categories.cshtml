@model Notenokand.Web.Models.Finance.FinanceCategoryPageViewModel
@using Notenokand.Domain.Enums
@{ ViewData["Title"] = "หมวดหมู่การเงิน"; }
<section class="finance-page category-page"><div class="page-breadcrumb"><a asp-action="Index">รายรับ–ค่าใช้จ่าย</a><span>/</span><span>หมวดหมู่</span></div><div class="editor-heading"><div><span class="eyebrow">ตั้งค่าการเงิน</span><h1>หมวดหมู่รายรับ–ค่าใช้จ่าย</h1><p>ปิดหมวดที่ไม่ใช้ได้ โดยข้อมูลย้อนหลังยังคงอยู่</p></div><a class="btn btn-soft" asp-action="Index">กลับหน้ารายการ</a></div>
<div class="category-layout"><section class="form-card category-create"><div class="section-heading"><span>+</span><div><h2>เพิ่มหมวดหมู่</h2><p>สร้างหมวดเฉพาะกิจการของคุณ</p></div></div><form method="post" asp-action="CreateCategory"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="form-field"><label asp-for="NewCategory.Type"></label><select asp-for="NewCategory.Type" class="form-select"><option value="@TransactionType.Expense">ค่าใช้จ่าย</option><option value="@TransactionType.Income">รายรับ</option></select></div><div class="form-field"><label asp-for="NewCategory.Name"></label><input asp-for="NewCategory.Name" class="form-control" placeholder="เช่น ค่าน้ำประปา" /><span asp-validation-for="NewCategory.Name"></span></div><button class="btn btn-primary w-100" type="submit">เพิ่มหมวดหมู่</button></form></section>
<section><div class="category-group-heading"><h2>หมวดหมู่ทั้งหมด</h2><span>@Model.Categories.Count รายการ</span></div><div class="category-card-list">@foreach(var item in Model.Categories){<article class="category-card @(item.IsActive ? "" : "inactive")"><span class="category-icon @(item.Type == TransactionType.Income ? "income" : "expense")">@(item.Type == TransactionType.Income ? "↗" : "↘")</span><div><small>@(item.Type == TransactionType.Income ? "รายรับ" : "ค่าใช้จ่าย") @(item.IsSystem ? "· ค่าเริ่มต้น" : "")</small><h3>@item.Name</h3></div><span class="status-badge @(item.IsActive ? "active" : "inactive")"><i></i>@(item.IsActive ? "ใช้งาน" : "ปิดใช้")</span><form method="post" asp-action="ToggleCategory" asp-route-id="@item.Id" data-category-toggle data-name="@item.Name" data-active="@item.IsActive.ToString().ToLowerInvariant()"><button class="btn btn-link @(item.IsActive ? "text-danger" : "text-success")" type="submit">@(item.IsActive ? "ปิดใช้" : "เปิดใช้")</button></form></article>}</div></section></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/finance-categories.js" asp-append-version="true"></script> }