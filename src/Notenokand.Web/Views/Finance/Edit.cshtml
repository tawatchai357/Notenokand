@model Notenokand.Web.Models.Finance.FinanceEditViewModel
@using Notenokand.Domain.Enums
@{ ViewData["Title"] = Model.IsEdit ? "แก้ไขรายการ" : "เพิ่มรายการ"; }
<section class="finance-page finance-editor-page">
    <div class="page-breadcrumb"><a asp-action="Index">รายรับ–ค่าใช้จ่าย</a><span>/</span><span>@ViewData["Title"]</span></div>
    <div class="editor-heading"><div><span class="eyebrow">@(Model.IsEdit ? "รายการเดิม" : "รายการใหม่")</span><h1>@ViewData["Title"]</h1><p>บันทึกข้อมูลให้ครบเพื่อดูสรุปรายเดือนที่ถูกต้อง</p></div><a class="btn btn-soft" asp-action="Index">ยกเลิก</a></div>
    <form method="post" enctype="multipart/form-data" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" data-finance-editor>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="finance-editor-grid"><section class="form-card"><div class="section-heading"><span>1</span><div><h2>รายละเอียดรายการ</h2><p>เลือกรายรับหรือค่าใช้จ่ายก่อนเลือกหมวดหมู่</p></div></div>
            <div class="transaction-type-switch">@foreach(var type in new[]{TransactionType.Expense, TransactionType.Income}){<label class="@(type == TransactionType.Expense ? "expense" : "income")"><input asp-for="Type" type="radio" value="@type" data-transaction-type /><span>@(type == TransactionType.Expense ? "↘ ค่าใช้จ่าย" : "↗ รายรับ")</span></label>}</div><span asp-validation-for="Type"></span>
            <div class="row g-3 mt-1"><div class="col-md-7 form-field"><label asp-for="Description"></label><input asp-for="Description" class="form-control" data-description-input placeholder="เช่น ค่าไฟฟ้าประจำเดือน" /><span asp-validation-for="Description"></span></div><div class="col-md-5 form-field"><label asp-for="Amount"></label><div class="input-group"><span class="input-group-text">฿</span><input asp-for="Amount" class="form-control" inputmode="decimal" placeholder="0.00" /></div><span asp-validation-for="Amount"></span></div>
            <div class="col-md-6 form-field thai-date-field"><label asp-for="TransactionDate"></label><input asp-for="TransactionDate" type="hidden" data-thai-date-value /><div class="thai-date-control"><input type="text" class="form-control" data-thai-datepicker data-target="TransactionDate" placeholder="เลือกวันที่" autocomplete="off" readonly /><button type="button" class="thai-date-trigger" data-thai-date-trigger aria-label="เปิดปฏิทิน">▦</button></div><span asp-validation-for="TransactionDate"></span></div>
            <div class="col-md-6 form-field"><label asp-for="CategoryId"></label><select asp-for="CategoryId" class="form-select" data-category-select><option value="">เลือกหมวดหมู่</option>@foreach(var option in Model.CategoryOptions){if(option.Id == Model.CategoryId){<option value="@option.Id" data-type="@option.Type" data-category-name="@option.Name" selected>@option.Name</option>}else{<option value="@option.Id" data-type="@option.Type" data-category-name="@option.Name">@option.Name</option>}}</select><span asp-validation-for="CategoryId"></span></div>
            <div class="col-md-6 form-field"><label asp-for="BuildingId"></label><select asp-for="BuildingId" asp-items="Model.Buildings" class="form-select"><option value="">ส่วนกลาง (ไม่ระบุตึก)</option></select><span asp-validation-for="BuildingId"></span></div><div class="col-md-6 form-field"><label asp-for="PaymentMethod"></label><select asp-for="PaymentMethod" class="form-select"><option value="@PaymentMethod.BankTransfer">โอนเงิน</option><option value="@PaymentMethod.Cash">เงินสด</option><option value="@PaymentMethod.CreditCard">บัตรเครดิต</option><option value="@PaymentMethod.Other">อื่น ๆ</option></select></div>
            <div class="col-md-6 form-field"><label asp-for="Counterparty" data-counterparty-label></label><input asp-for="Counterparty" class="form-control" data-counterparty-input placeholder="ชื่อร้านค้า ลูกค้า หรือผู้รับเงิน" /><span asp-validation-for="Counterparty"></span></div><div class="col-md-6 form-field"><label asp-for="ReferenceNumber"></label><input asp-for="ReferenceNumber" class="form-control" placeholder="เลขใบเสร็จ/เลขอ้างอิง" /></div><div class="col-md-6 form-field" data-bird-nest-sale-field hidden><label asp-for="SaleLocation"></label><input asp-for="SaleLocation" class="form-control" data-sale-required placeholder="เช่น ลานประมูลสุราษฎร์ธานี หรือผู้ซื้อที่บ้าน" /><span asp-validation-for="SaleLocation"></span></div><div class="col-md-6 form-field" data-bird-nest-sale-field hidden><label asp-for="AveragePricePerKg"></label><div class="input-group"><span class="input-group-text">฿</span><input asp-for="AveragePricePerKg" class="form-control" data-sale-required inputmode="decimal" placeholder="0.00" /><span class="input-group-text">/ กก.</span></div><span asp-validation-for="AveragePricePerKg"></span></div><div class="col-12 form-field"><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control" rows="3" placeholder="รายละเอียดเพิ่มเติม (ไม่บังคับ)"></textarea></div></div>
        </section><aside class="form-card receipt-card"><div class="section-heading"><span>2</span><div><h2>หลักฐาน</h2><p>แนบได้ครั้งละ 1 ไฟล์ สูงสุด 10 MB</p></div></div><label class="receipt-uploader"><input asp-for="Receipt" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" data-receipt-input /><span>⇧</span><strong>เลือกใบเสร็จหรือหลักฐาน</strong><small data-receipt-name>JPG, PNG, WEBP หรือ PDF</small></label><span asp-validation-for="Receipt"></span>
        @if(Model.ExistingReceipts.Count > 0){<div class="existing-receipts"><h3>ไฟล์ที่แนบแล้ว</h3>@foreach(var receipt in Model.ExistingReceipts){<div><button type="button" class="receipt-preview-link" data-bs-toggle="modal" data-bs-target="#receiptPreviewModal" data-receipt-preview data-receipt-url="@Url.Action("Receipt", new { id = receipt.Id })" data-receipt-name="@receipt.FileName">@receipt.FileName</button><small>@((receipt.SizeBytes / 1024d).ToString("N0")) KB</small><button type="submit" class="btn btn-link text-danger" formaction="@Url.Action("DeleteReceipt", new { id = receipt.Id })" formmethod="post" data-delete-receipt>ลบ</button></div>}</div>}</aside></div>
        <div class="sticky-save"><a class="btn btn-soft" asp-action="Index">ยกเลิก</a><button class="btn btn-primary btn-lg" type="submit">บันทึกรายการ <span>→</span></button></div>
    </form>
</section>
<partial name="_ReceiptPreviewModal" />
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/finance-editor.js" asp-append-version="true"></script><script src="~/js/receipt-preview.js" asp-append-version="true"></script> }