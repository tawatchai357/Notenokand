@model Notenokand.Web.Models.Account.OnboardingViewModel
@{ ViewData["Title"] = "ตั้งค่ากิจการ"; ViewData["BodyClass"] = "onboarding-page"; }
<section class="setup-shell"><header class="setup-header"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">N</span><span>NOTENOKAND</span></a><div class="setup-progress"><span>ขั้นตอนที่ 2 จาก 2</span><div><i></i><i></i></div></div></header><main class="setup-card"><div class="setup-title"><span class="feature-icon">⌂</span><div><h1>ตั้งค่ากิจการของคุณ</h1><p>ข้อมูลนี้ใช้แยกรายงาน ค่าใช้จ่าย และสมาชิกของแต่ละกิจการ</p></div></div><form asp-action="Index" method="post" enctype="multipart/form-data" data-address-form data-photo-form><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="section-heading"><span>1</span><div><h2>ข้อมูลกิจการ</h2><p>คุณแก้ไขภายหลังได้</p></div></div><div class="row g-3"><div class="col-md-8 form-field"><label asp-for="AccountName"></label><input asp-for="AccountName" class="form-control" placeholder="เช่น บ้านรังนกสมุย" /><span asp-validation-for="AccountName"></span></div><div class="col-md-4 form-field"><label asp-for="BusinessType"></label><select asp-for="BusinessType" class="form-select"><option value="">เลือกประเภท</option><option>ผู้ประกอบการบ้านนกแอ่น</option><option>ผู้รับซื้อ</option><option>ผู้แปรรูป</option><option>อื่น ๆ</option></select></div><div class="col-md-6 form-field"><label asp-for="TaxId"></label><span class="optional">ไม่บังคับ</span><input asp-for="TaxId" class="form-control" inputmode="numeric" /></div></div><div class="section-heading"><span>2</span><div><h2>ที่อยู่กิจการ</h2><p>ระบบจะแสดงตัวเลือกต่อเนื่องและเติมรหัสไปรษณีย์ให้</p></div></div><div class="form-field"><label asp-for="AddressLine"></label><input asp-for="AddressLine" class="form-control" placeholder="เลขที่ หมู่ ซอย ถนน" /></div><div class="row g-3"><div class="col-md-6 form-field"><label asp-for="ProvinceCode"></label><select asp-for="ProvinceCode" asp-items="Model.Provinces" class="form-select" data-province><option value="">เลือกจังหวัด</option></select><span asp-validation-for="ProvinceCode"></span></div><div class="col-md-6 form-field"><label asp-for="DistrictCode"></label><select asp-for="DistrictCode" class="form-select" data-district data-selected="@Model.DistrictCode" disabled><option value="">เลือกอำเภอ/เขต</option></select><span asp-validation-for="DistrictCode"></span></div><div class="col-md-6 form-field"><label asp-for="SubdistrictCode"></label><select asp-for="SubdistrictCode" class="form-select" data-subdistrict data-selected="@Model.SubdistrictCode" disabled><option value="">เลือกตำบล/แขวง</option></select><span asp-validation-for="SubdistrictCode"></span></div><div class="col-md-6 form-field"><label asp-for="PostalCode"></label><select asp-for="PostalCode" class="form-select" data-postal data-selected="@Model.PostalCode" disabled><option value="">รหัสไปรษณีย์</option></select><span asp-validation-for="PostalCode"></span></div></div><div class="section-heading"><span>3</span><div><h2>ตึกนกแห่งแรก</h2><p>ข้ามได้และเพิ่มภายหลัง</p></div></div><div class="form-field"><label asp-for="BuildingName"></label><span class="optional">ไม่บังคับ</span><input asp-for="BuildingName" class="form-control" placeholder="เช่น ตึกนกหลังใหญ่" /></div><div class="form-field building-photo-field"><label asp-for="BuildingPhoto"></label><span class="optional">ไม่บังคับ · JPG, PNG, WEBP ไม่เกิน 5 MB</span><label class="photo-uploader" data-photo-drop><input asp-for="BuildingPhoto" type="file" accept="image/jpeg,image/png,image/webp" data-photo-input /><span class="photo-preview" data-photo-preview><b>＋</b><strong>เลือกรูปตึกนก</strong><small>แตะเพื่อเลือกจากมือถือหรือคอมพิวเตอร์</small></span></label><span asp-validation-for="BuildingPhoto"></span></div><div class="setup-actions"><button class="btn btn-primary btn-lg" type="submit">เริ่มใช้งาน Notenokand <span>→</span></button></div></form></main></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/address-dropdowns.js" asp-append-version="true"></script><script src="~/js/building-photo.js" asp-append-version="true"></script> }