@{ ViewData["Title"] = "ตรวจสอบอีเมล"; ViewData["BodyClass"] = "auth-page simple-auth"; var devUrl = ViewBag.DevelopmentConfirmationUrl as string; }
<section class="center-card"><div class="status-icon">✉</div><span class="step-label">ยืนยันตัวตน</span><h1>ตรวจสอบอีเมลของคุณ</h1><p>เราได้สร้างลิงก์ยืนยันสำหรับ <strong>@ViewBag.Email</strong> แล้ว กรุณายืนยันก่อนเข้าสู่ระบบ</p>@if (!string.IsNullOrWhiteSpace(devUrl)) { <div class="dev-notice"><strong>โหมดพัฒนา</strong><p>ยังไม่ได้เชื่อมบริการส่งอีเมล จึงแสดงลิงก์ทดสอบไว้ที่นี่</p><a class="btn btn-primary w-100" href="@devUrl">ยืนยันอีเมลและไปต่อ</a></div> }<form asp-action="ResendConfirmation" method="post"><input type="hidden" name="email" value="@ViewBag.Email" /><button class="btn btn-link" type="submit">สร้างลิงก์ยืนยันใหม่</button></form><a asp-action="Login">กลับไปหน้าเข้าสู่ระบบ</a></section>