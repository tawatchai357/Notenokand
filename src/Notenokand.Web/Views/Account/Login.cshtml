@model Notenokand.Web.Models.Account.LoginViewModel
@{ ViewData["Title"] = "เข้าสู่ระบบ"; ViewData["BodyClass"] = "auth-page"; }
<section class="auth-shell auth-shell-login"><div class="auth-intro d-none d-lg-flex"><a class="brand brand-light" asp-controller="Home" asp-action="Index"><span class="brand-mark">N</span><span>NOTENOKAND</span></a><div><span class="hero-pill">ยินดีต้อนรับกลับ</span><h1>ข้อมูลพร้อม<br />ให้คุณตัดสินใจ</h1><p>ติดตามกิจการ ต้นทุน และผลผลิตได้จากหน้าจอเดียว</p></div><div class="trust-note"><span>✓</span> ออกแบบเพื่อมือถือ แท็บเล็ต และคอมพิวเตอร์</div></div><div class="auth-panel"><div class="auth-card"><a class="brand d-lg-none mb-4" asp-controller="Home" asp-action="Index"><span class="brand-mark">N</span><span>NOTENOKAND</span></a><h2>เข้าสู่ระบบ</h2><p class="text-secondary">กรอกข้อมูลเพื่อไปยังพื้นที่ทำงานของคุณ</p><form asp-action="Login" method="post" class="mt-4"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="form-field"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" inputmode="email" placeholder="name@example.com" /><span asp-validation-for="Email"></span></div><div class="form-field"><label asp-for="Password"></label><div class="password-wrap"><input asp-for="Password" class="form-control" autocomplete="current-password" /><button type="button" class="password-toggle" aria-label="แสดงรหัสผ่าน">ดู</button></div><span asp-validation-for="Password"></span></div><div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div><button class="btn btn-primary btn-lg w-100" type="submit">เข้าสู่ระบบ <span>→</span></button></form><p class="auth-switch">ยังไม่มีบัญชี? <a asp-action="Register">สมัครสมาชิกฟรี</a></p></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }