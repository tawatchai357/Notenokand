@model Notenokand.Web.Models.Members.MembersPageModel
@{ViewData["Title"]="ผู้ร่วมงาน";}
<section class="finance-page"><h1>ผู้ร่วมงานและสิทธิ์</h1><p>เจ้าของจัดการทั้งหมด · ผู้บันทึกแก้ไขได้เฉพาะตึกที่มอบหมาย · ผู้ดูอ่านอย่างเดียว</p>
@if(TempData["MemberError"] is string error){<div class="alert alert-warning">@error</div>}
@if(TempData["DevelopmentInviteUrl"] is string url){<div class="alert alert-info">โหมดพัฒนา: <a href="@url">เปิดลิงก์คำเชิญ</a></div>}
<form asp-action="Invite" method="post" class="content-card row g-2 mb-3"><div class="col-sm-7"><label>อีเมล</label><input name="Email" type="email" required class="form-control" /></div><div class="col-sm-3"><label>สิทธิ์</label><select name="Role" class="form-select"><option value="Editor">ผู้บันทึก</option><option value="Viewer">ผู้ดู</option></select></div><div class="col-sm-2 d-flex align-items-end"><button class="btn btn-primary w-100">เชิญ</button></div></form>
@foreach(var member in Model.Members){<article class="content-card mb-3"><div class="section-toolbar"><div><h2>@member.Name</h2><p>@member.Email · @member.Role · @(member.Active?"ใช้งาน":"ปิดใช้งาน")</p></div></div>
@if(member.Role!="Owner"){<div class="d-flex flex-wrap gap-2"><form asp-action="Role" asp-route-userId="@member.UserId" method="post"><select name="role" class="form-select" onchange="this.form.submit()"><option value="Editor" selected="@(member.Role=="Editor")">ผู้บันทึก</option><option value="Viewer" selected="@(member.Role=="Viewer")">ผู้ดู</option></select></form><form asp-action="Toggle" asp-route-userId="@member.UserId" method="post"><button class="btn btn-soft">@(member.Active?"ปิดใช้งาน":"เปิดใช้งาน")</button></form></div>
<h3 class="h6 mt-3">ตึกที่มอบหมาย</h3><div class="d-flex flex-wrap gap-2">@foreach(var building in Model.Buildings){var id=Guid.Parse(building.Value);var checkedValue=member.BuildingIds.Contains(id);<form asp-action="Assign" asp-route-userId="@member.UserId" method="post"><input type="hidden" name="buildingId" value="@id" /><input type="hidden" name="allowed" value="@(!checkedValue)" /><button class="btn @(checkedValue?"btn-primary":"btn-soft")">@(checkedValue?"✓ ":"")@building.Text</button></form>}</div>}
</article>}</section>
