@model Notenokand.Web.Models.Buildings.BuildingEditViewModel
@using Notenokand.Domain.Enums
@{ ViewData["Title"] = Model.IsEdit ? "แก้ไขตึกนก" : "เพิ่มตึกนก"; }
@section Head { <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" /> }
<section class="building-editor"><div class="page-breadcrumb"><a asp-controller="Dashboard" asp-action="Index">ภาพรวม</a><span>/</span><span>@ViewData["Title"]</span></div><div class="editor-heading"><div><span class="eyebrow">@(Model.IsEdit ? Model.Code : "ตึกใหม่")</span><h1>@ViewData["Title"]</h1><p>กรอกข้อมูลที่อยู่และปักหมุดตำแหน่งจริงของตึกบนแผนที่</p></div><a class="btn btn-soft" asp-controller="Dashboard" asp-action="Index">ยกเลิก</a></div>
<form method="post" enctype="multipart/form-data" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" data-address-form data-building-form data-photo-form><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="editor-grid"><div class="editor-fields"><section class="form-card"><div class="section-heading"><span>1</span><div><h2>ข้อมูลตึก</h2><p>ชื่อและรายละเอียดพื้นฐาน</p></div></div><div class="row g-3"><div class="col-sm-4 form-field"><label asp-for="Code"></label><input asp-for="Code" class="form-control text-uppercase" /><span asp-validation-for="Code"></span></div><div class="col-sm-8 form-field"><label asp-for="Name"></label><input asp-for="Name" class="form-control" placeholder="เช่น ตึกนกหลังใหญ่" /><span asp-validation-for="Name"></span></div><div class="col-sm-4 form-field"><label asp-for="BuiltOrPurchasedYearBuddhist"></label><input asp-for="BuiltOrPurchasedYearBuddhist" class="form-control" inputmode="numeric" placeholder="เช่น 2565" /><span asp-validation-for="BuiltOrPurchasedYearBuddhist"></span></div><div class="col-sm-4 form-field thai-date-field"><label asp-for="StartedOn"></label><input asp-for="StartedOn" type="hidden" data-thai-date-value /><div class="thai-date-control"><input type="text" class="form-control" data-thai-datepicker data-target="StartedOn" placeholder="เลือกวันที่" autocomplete="off" readonly /><button type="button" class="thai-date-trigger" data-thai-date-trigger aria-label="เปิดปฏิทิน">▦</button></div><span asp-validation-for="StartedOn"></span></div><div class="col-sm-2 form-field"><label asp-for="FloorCount"></label><input asp-for="FloorCount" class="form-control" inputmode="numeric" /></div><div class="col-sm-2 form-field"><label asp-for="RoomCount"></label><input asp-for="RoomCount" class="form-control" inputmode="numeric" /></div><div class="col-sm-4 form-field"><label asp-for="WidthMeters"></label><input asp-for="WidthMeters" class="form-control" inputmode="decimal" placeholder="เช่น 12.50" /><span asp-validation-for="WidthMeters"></span></div><div class="col-sm-4 form-field"><label asp-for="DepthMeters"></label><input asp-for="DepthMeters" class="form-control" inputmode="decimal" placeholder="เช่น 20.00" /><span asp-validation-for="DepthMeters"></span></div><div class="col-sm-4 form-field"><label asp-for="AreaSquareMeters"></label><input asp-for="AreaSquareMeters" class="form-control" inputmode="decimal" /><span asp-validation-for="AreaSquareMeters"></span></div><div class="col-sm-6 form-field"><label asp-for="ConstructionBudget"></label><div class="input-group"><span class="input-group-text">฿</span><input asp-for="ConstructionBudget" class="form-control" inputmode="decimal" placeholder="0.00" /></div><span asp-validation-for="ConstructionBudget"></span></div><div class="col-sm-6 form-field"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option value="@BuildingStatus.Active">ใช้งาน</option><option value="@BuildingStatus.Inactive">ไม่ใช้งาน</option></select></div><div class="col-12 form-field building-photo-field"><label asp-for="Photo"></label><span class="optional">@(Model.HasPhoto ? "เลือกรูปใหม่เพื่อแทนรูปเดิม" : "ไม่บังคับ") · JPG, PNG, WEBP ไม่เกิน 5 MB</span><label class="photo-uploader" data-photo-drop><input asp-for="Photo" type="file" accept="image/jpeg,image/png,image/webp" data-photo-input /><span class="photo-preview @(Model.HasPhoto ? "has-image" : "")" data-photo-preview data-current-photo="@(Model.HasPhoto ? Url.Action("Photo", "Buildings", new { id = Model.Id }) : null)">@if(Model.HasPhoto){<img src="@Url.Action("Photo", "Buildings", new { id = Model.Id })" alt="รูปตึก @Model.Name" />}<b>＋</b><strong>@(Model.HasPhoto ? "เปลี่ยนรูปตึก" : "เลือกรูปตึกนก")</strong><small>แตะเพื่อเลือกจากมือถือหรือคอมพิวเตอร์</small></span></label><span asp-validation-for="Photo"></span></div></div></section><section class="form-card"><div class="section-heading"><span>2</span><div><h2>ที่อยู่ตึก</h2><p>เลือกตามลำดับเพื่อป้องกันรหัสพื้นที่ผิด</p></div></div><div class="form-field"><label asp-for="Address"></label><input asp-for="Address" class="form-control" placeholder="เลขที่ หมู่ ซอย ถนน" /></div><div class="row g-3"><div class="col-sm-6 form-field"><label asp-for="ProvinceCode"></label><select asp-for="ProvinceCode" asp-items="Model.Provinces" class="form-select" data-province><option value="">เลือกจังหวัด</option></select><span asp-validation-for="ProvinceCode"></span></div><div class="col-sm-6 form-field"><label asp-for="DistrictCode"></label><select asp-for="DistrictCode" class="form-select" data-district data-selected="@Model.DistrictCode" disabled><option value="">เลือกอำเภอ/เขต</option></select><span asp-validation-for="DistrictCode"></span></div><div class="col-sm-6 form-field"><label asp-for="SubdistrictCode"></label><select asp-for="SubdistrictCode" class="form-select" data-subdistrict data-selected="@Model.SubdistrictCode" disabled><option value="">เลือกตำบล/แขวง</option></select><span asp-validation-for="SubdistrictCode"></span></div><div class="col-sm-6 form-field"><label asp-for="PostalCode"></label><select asp-for="PostalCode" class="form-select" data-postal data-selected="@Model.PostalCode" disabled><option value="">รหัสไปรษณีย์</option></select><span asp-validation-for="PostalCode"></span></div></div></section><section class="form-card"><div class="section-heading"><span>3</span><div><h2>หมายเหตุ</h2><p>ข้อมูลเพิ่มเติมสำหรับทีมงาน</p></div></div><textarea asp-for="Notes" class="form-control" rows="3" placeholder="รายละเอียดเพิ่มเติม (ไม่บังคับ)"></textarea></section></div><aside class="map-card"><div class="map-card-heading"><div><h2>ตำแหน่งบนแผนที่</h2><p>แตะแผนที่หรือลากหมุดไปยังตำแหน่งตึก</p></div><button type="button" class="btn btn-soft btn-sm" data-current-location>◎ ตำแหน่งปัจจุบัน</button></div><div id="building-map" class="building-map"></div><input asp-for="Latitude" type="hidden" data-latitude /><input asp-for="Longitude" type="hidden" data-longitude /><div class="coordinate-row"><div><small>ละติจูด</small><strong data-latitude-label>@(Model.Latitude?.ToString("0.0000000") ?? "ยังไม่ปักหมุด")</strong></div><div><small>ลองจิจูด</small><strong data-longitude-label>@(Model.Longitude?.ToString("0.0000000") ?? "ยังไม่ปักหมุด")</strong></div></div><span asp-validation-for="Latitude" class="map-validation"></span><span asp-validation-for="Longitude" class="map-validation"></span><div class="map-help">ข้อมูลแผนที่ © OpenStreetMap contributors · ไม่ส่งที่อยู่ของคุณไปค้นหาภายนอก</div></aside></div><div class="sticky-save"><a class="btn btn-soft" asp-controller="Dashboard" asp-action="Index">ยกเลิก</a><button class="btn btn-primary btn-lg" type="submit">บันทึกตึกนก <span>→</span></button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script><script src="~/js/address-dropdowns.js" asp-append-version="true"></script><script src="~/js/building-map.js" asp-append-version="true"></script><script src="~/js/building-photo.js" asp-append-version="true"></script> }